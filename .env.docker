# ---------------------------------------------------------------------------
# Déploiement autonome du dashboard entreprise (docker-compose.yml).
#   cp .env.docker .env
#
# ATTENTION — ce fichier ne configure que le RUNTIME. Les URLs publiques
# (`NEXT_PUBLIC_APP_URL`, `NEXT_PUBLIC_SOCKET_URL`, et l'`API_URL` lue par
# `src/proxy.ts` pour la CSP) sont figées DANS L'IMAGE au build : elles se
# passent en `--build-arg` (voir `scripts/release.sh` et le Dockerfile), pas
# ici. Les changer impose de reconstruire l'image.
# ---------------------------------------------------------------------------

# Tag de l'image à déployer (test-latest, latest, test-v1.0.0, …)
COMPANY_ADMIN_TAG=latest

# Port publié sur l'hôte
COMPANY_ADMIN_PORT=3000

# URL de l'API NestJS vue depuis le conteneur.
# Sur le même réseau Docker : http://api:3001
API_URL=http://api:3001

# Timeout des appels vers l'API, en millisecondes
API_TIMEOUT_MS=15000

# `1` = cookies `Secure`. Redondant avec NODE_ENV=production, qui l'implique
# déjà — mais explicite, pour qu'un NODE_ENV rabaissé le temps d'un débogage
# ne renvoie pas les cookies en clair derrière un proxy HTTPS.
FORCE_SECURE_COOKIES=1
