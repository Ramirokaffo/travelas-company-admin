# ---------------------------------------------------------------------------
# Travelas Company Admin — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
#
# REGLE DE SECURITE : aucune variable sensible ne doit être préfixée
# `NEXT_PUBLIC_` — ce préfixe expose la valeur dans le bundle navigateur.
# ---------------------------------------------------------------------------

# URL de l'API NestJS (SERVEUR UNIQUEMENT — jamais appelée depuis le navigateur).
API_URL=http://localhost:3001

# Timeout des appels vers l'API NestJS, en millisecondes.
API_TIMEOUT_MS=15000

# Origine PUBLIQUE des fichiers téléversés (logos, bannières, photos), telle
# que le navigateur la voit dans les URLs renvoyées par le backend. Elle seule
# alimente `img-src` dans la CSP (`src/proxy.ts`).
#
# À renseigner dès que l'API est jointe par une adresse interne : en production
# `API_URL` vaut `http://api:3001`, que le navigateur ne peut pas atteindre —
# les images seraient bloquées sans erreur réseau visible.
# Plusieurs origines possibles, séparées par des virgules (CDN, bucket).
# Vide en local : on retombe sur `API_URL`, qui est déjà l'adresse publique.
MEDIA_URL=

# URL publique de ce dashboard (utilisée pour la vérification d'origine CSRF).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nom de l'application affiché dans l'interface.
NEXT_PUBLIC_APP_NAME=Travelas Entreprise

# Point d'entrée socket.io du backend, pour les notifications en temps réel.
# Seule exception au pattern BFF : une WebSocket ne se relaie pas via un route
# handler. Aucun secret ici — l'authentification passe par un ticket à usage
# unique délivré par `/api/notifications/socket-ticket`.
# Laisser vide pour désactiver le temps réel (le centre reste fonctionnel).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# `1` pour forcer les cookies `Secure` même hors production (ex. tunnel HTTPS).
FORCE_SECURE_COOKIES=0
